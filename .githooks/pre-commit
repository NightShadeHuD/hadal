#!/bin/sh
# pre-commit hook: runs cargo xtask gate before each commit.
#
# On Windows, use `git config core.hooksPath .githooks` to enable.
# chmod +x is not possible on Windows; the hook runs via git config instead.
#
# Install: git config core.hooksPath .githooks

echo "Running pre-commit gate..."
cargo xtask gate
exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo ""
    echo "Pre-commit gate FAILED. Commit aborted."
    echo "Run 'cargo xtask gate' to see detailed errors."
fi

exit $exit_code
